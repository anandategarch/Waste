# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so

# Distribution / packaging
build/
dist/
*.egg-info/
*.egg

# Virtual env
venv/
.env/
.venv/

# IDE
.vscode/
.idea/
*.swp
*.swo

# Output generated
output/*.xlsx
output/*.csv
output/*.json
output/*.log

# Filter profiles (user-specific, auto-generated)
filters.json
followup.json
followup.json.bad
followup.json.tmp

# Daftar file pembanding periode (user-specific, auto-generated — v2.10.0)
history_files.json

# Sample data (jangan commit data asli — DATA_WASTE.xlsx user-specific)
data/*.xlsx
data/*.xlsm
data/*.xls
!data/README.md

# v2.18.0 (audit keamanan) — DATA BISNIS ASLI di ROOT juga dilindungi:
# aturan lama hanya menutup data/ → BJMHAS.xlsx (7,5MB) & "REKAP MENTAH
# …TEGAR.xlsx" (10,5MB, 54rb baris data waste resto asli + nama
# karyawan) ter-commit di repo publik. Root xlsx di-ignore semua;
# SATU-SATUNYA pengecualian = sample_workbook.xlsx (sintetis,
# dibuat make_sample.py seed 42 — fixture CI).
/*.xlsx
!sample_workbook.xlsx

# Crash file startup pythonw (v2.18.0)
crash_startup.txt

# Backup source_writer (*.bak-YYYYMMDD-HHMMSS.xlsx sudah tertutup /*.xlsx)
*.bak-*

# Logs
*.log
server.log

# OS
.DS_Store
Thumbs.db

# Config user (boleh di-commit untuk default, uncomment baris bawah kalau mau lokal)
# config.local.json

# Log aplikasi (F11 v2.4.0 — rotating file logs)
logs/
*.log.*

# stub libEGL sandbox (workaround lingkungan test, bukan kode aplikasi)
.egl-stub/
